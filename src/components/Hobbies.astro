---
import { hobbiesSection } from "../data/profile";
import FloatingCodeBg from "./FloatingCodeBg.astro";

const iconPaths: Record<string, string> = {
  code: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  fitness:
    "M20.24 12.24a6 6 0 00-8.49-8.49L5 10.5V19h8.5l6.74-6.76zM16 8L2 22M17.5 15H9",
  hiking:
    "M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0",
  travel:
    "M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
};
---

<section id="hobbies" class="section bg-[var(--surface)] relative">
  <FloatingCodeBg />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="section-title text-[var(--text)]" data-animate>
      {hobbiesSection.title}
    </h2>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        hobbiesSection.items.map((item) => (
          <div
            class="card p-6 text-center group hover:border-[var(--color-accent)]/50 transition-colors"
            data-animate
          >
            {/* Icon */}
            <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-[var(--color-accent)]/10 to-purple-500/10 flex items-center justify-center group-hover:from-[var(--color-accent)]/20 group-hover:to-purple-500/20 transition-colors">
              <svg
                class="w-7 h-7 text-[var(--color-accent)]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={iconPaths[item.icon]}
                />
              </svg>
            </div>

            <h3 class="text-lg font-semibold text-[var(--text)] mb-2">
              {item.name}
            </h3>

            <p class="text-sm text-[var(--text-muted)] leading-relaxed">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
