---
import { experienceSection, type ExperienceItem } from "../data/profile";
const items: ExperienceItem[] = experienceSection.items;
---

<section id="experience" class="section experience-section">
  <div class="page-shell">
    <p class="eyebrow section-kicker">02 / Практика</p>
    <h2 class="section-title" data-animate>{experienceSection.title}</h2>
    <div class="experience-list">
      {items.map((item, index) => (
        <article class:list={["experience-entry", { "experience-current": item.current }]} data-animate>
          <div class="experience-meta">
            <span class="experience-index">0{index + 1}</span>
            <h3>{item.company}</h3>
            <p>{item.period}</p>
            {item.current && <span class="current-label"><span class="status-dot" aria-hidden="true" /> Сейчас здесь</span>}
          </div>
          <div class="experience-content">
            <h4>{item.position}</h4>
            <p class="experience-description">{item.description}</p>
            {item.achievements && <div class="experience-results"><h5>Ключевые результаты</h5><ul class="achievement-list">{item.achievements.map((achievement) => <li>{achievement}</li>)}</ul></div>}
            {(item.architecture || item.responsibilities) && (
              <details class="experience-details">
                <summary>Подробнее о работе <span aria-hidden="true">+</span></summary>
                <div class="experience-details-body">
                  {item.architecture && <div><h5>Архитектурные решения</h5><ul class="achievement-list">{item.architecture.map((point) => <li>{point}</li>)}</ul></div>}
                  {item.responsibilities && <div><h5>Зона ответственности</h5><ul class="achievement-list">{item.responsibilities.map((point) => <li>{point}</li>)}</ul></div>}
                  {item.team && <p class="experience-description"><strong>Команда:</strong> {item.team}</p>}
                </div>
              </details>
            )}
            <div class="tech-list" aria-label="Технологии">{item.technologies.map((tech) => <span class="badge">{tech}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
