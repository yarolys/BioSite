---
import { profile, heroSection } from "../data/profile";
const telegram = profile.socials.find((social) => social.icon === "telegram")!;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid page-shell">
    <div class="hero-copy" data-animate>
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> {profile.title}</p>
      <h1 id="hero-title">Ярослав<br /><span>Лысов.</span></h1>
      <p class="hero-intro">{heroSection.intro}</p>
      <p class="hero-description">{heroSection.description}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={telegram.url} target="_blank" rel="noopener noreferrer">Написать в Telegram <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="#experience">Посмотреть опыт <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-links">
        <span>{profile.location}</span><span aria-hidden="true">/</span>
        {profile.socials.filter((social) => social.icon !== "telegram").map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer">{social.name} ↗</a>)}
      </div>
    </div>
    <div class="hero-visual" data-animate>
      <div class="portrait-frame">
        <div class="portrait-topline"><span>yarolys / profile</span><span aria-hidden="true">↗</span></div>
        <img src={profile.avatarPath} alt={`Фото: ${profile.fullName}`} width="480" height="560" loading="eager" fetchpriority="high" decoding="async" />
        <div class="portrait-caption"><span>Сейчас в Camirix</span><strong>От архитектуры<br />до работающего продукта.</strong></div>
      </div>
      <div class="hero-note"><span aria-hidden="true">{"{ }"}</span> Backend. AI. Люди.</div>
    </div>
  </div>
  <div class="hero-proof page-shell">
    <p class="eyebrow">AI-инфраструктура<br /><span>в Camirix</span></p>
    {heroSection.highlights.map((item) => <div class="proof-item"><strong>{item.value}</strong><span>{item.label}</span></div>)}
  </div>
</section>
