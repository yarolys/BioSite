---
import { profile } from "../data/profile";
import SocialIcons from "./SocialIcons.astro";
import FloatingCodeBg from "./FloatingCodeBg.astro";
---

<section class="min-h-screen flex items-center justify-center pt-16 pb-8 px-4 relative">
  <FloatingCodeBg />

  <div class="parallax-container w-full max-w-2xl relative z-10">
    <div
      class="parallax-card card p-8 sm:p-12 text-center"
      data-animate
    >
      <!-- Avatar -->
      <div class="relative inline-block mb-6">
        <div
          class="w-32 h-32 sm:w-40 sm:h-40 rounded-full overflow-hidden ring-4 ring-[var(--color-accent)]/30 shadow-xl"
        >
          <img
            src={profile.avatarPath}
            alt={`Фото ${profile.fullName}`}
            width="160"
            height="160"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
        <!-- Decorative gradient ring -->
        <div
          class="absolute inset-0 rounded-full bg-gradient-to-br from-[var(--color-accent)] to-purple-500 opacity-20 blur-xl -z-10 scale-110"
          aria-hidden="true"
        >
        </div>
      </div>

      <!-- Name and title -->
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text)] mb-2">
        {profile.fullName}
      </h1>

      <p
        class="text-lg sm:text-xl font-medium text-[var(--color-accent)] mb-2"
      >
        {profile.title}
      </p>

      <p class="text-[var(--text-muted)] mb-8 flex items-center justify-center gap-2">
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {profile.location}
      </p>

      <!-- Social links -->
      <SocialIcons socials={profile.socials} />

      <!-- Scroll indicator -->
      <div class="mt-12 animate-bounce" aria-hidden="true">
        <svg
          class="w-6 h-6 mx-auto text-[var(--text-muted)]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>
  </div>
</section>
