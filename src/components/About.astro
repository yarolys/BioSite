---
import { aboutSection, skillGroups } from "../data/profile";
---
<section id="about" class="section">
  <div class="page-shell">
    <p class="eyebrow section-kicker">01 / Знакомство</p>
    <h2 class="section-title" data-animate>{aboutSection.title}</h2>
    <div class="about-grid">
      <div class="about-copy" data-animate>
        {aboutSection.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="skill-groups" data-animate>
        {skillGroups.map((group) => <div class="skill-group"><h3>{group.title}</h3><div class="tech-list">{group.skills.map((skill) => <span class="badge">{skill}</span>)}</div></div>)}
      </div>
    </div>
  </div>
</section>
